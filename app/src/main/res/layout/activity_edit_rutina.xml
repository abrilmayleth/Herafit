<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFEE">


    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:contentDescription="Volver"
        android:focusable="true"
        android:src="@android:drawable/ic_menu_revert"
        android:tint="#F0037F" />

    <ImageView
        android:id="@+id/appLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="50dp"
        android:contentDescription="Herafit App Logo"
        android:src="@drawable/herafitlohoh_copia" />

    <EditText
        android:id="@+id/nombre"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Nombre de la rutina"
        android:fontFamily="serif"
        android:layout_gravity="center"/>

    <EditText
        android:id="@+id/descripcion"
        android:hint="Descripción"
        android:fontFamily="serif"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_gravity="center"/>

    <!--boton actualizar rutina-->
    <Button
        android:id="@+id/updateBtn"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#F0037F"
        android:fontFamily="serif"
        android:layout_gravity="center"
        android:text="Actualizar Rutina"
        android:textColor="#F6CDE2" />

    <Button
        android:id="@+id/cancelBtn"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        android:fontFamily="serif"
        android:layout_gravity="center"
        android:textAllCaps="false"
        android:layout_marginTop="12dp"
        android:textColor="#F0037F"
        android:backgroundTint="#F6CDE2"/>

</LinearLayout>